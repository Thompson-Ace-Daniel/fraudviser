PORT=3000
MONGODB_URL=mongodb://127.0.0.1:27017
FRONTEND_ORIGIN=http://localhost:5173
# Set COOKIE_SAME_SITE=none only when the deployed frontend and API use different sites; this requires HTTPS.
COOKIE_SAME_SITE=lax
# Optional secret for trusted server-side market data imports. Never expose this in the browser.
MARKET_IMPORT_TOKEN=
# Optional: enables one structured Gemini opinion per listing (the asking price is not sent to AI)
GEMINI_API_KEY=
# Optional: choose the Gemini Flash model used for the single JSON response
# GEMINI_MODEL=gemini-3.8-flash
