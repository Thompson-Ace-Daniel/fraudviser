PORT=3000
MONGODB_URL=mongodb://127.0.0.1:27017
FRONTEND_ORIGIN=http://localhost:5173
# Set COOKIE_SAME_SITE=none only when the deployed frontend and API use different sites; this requires HTTPS.
COOKIE_SAME_SITE=lax
# Optional secret for trusted server-side market data imports. Never expose this in the browser.
MARKET_IMPORT_TOKEN=
# Optional: enables the Gemini-generated listing review
GEMINI_API_KEY=
# Optional: overrides the default Gemini model
GEMINI_MODEL=gemini-3.8-flash
